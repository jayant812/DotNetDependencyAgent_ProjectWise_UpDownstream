<Window x:Class="DotNetDependencyAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=".NET Dependency Agent" Height="780" Width="1180" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text=".NET Dependency Agent" FontSize="28" FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,14" Text="Analyze a GitHub repository or local .csproj for NuGet packages, project references, source dependencies, call flow, and Gemini AI architecture analysis." TextWrapping="Wrap" Foreground="DimGray"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D7D7D7" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Project source" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="GitHubRadio" IsChecked="True" Content="GitHub Repository URL" Margin="0,0,22,0" Checked="InputModeChanged"/>
                    <RadioButton x:Name="LocalRadio" Content="Local .csproj" Checked="InputModeChanged"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Input" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBox x:Name="InputTextBox" Grid.Row="1" Grid.Column="1" Margin="0,12,8,0" Height="30" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" Padding="16,4" Content="Browse..." Click="Browse_Click" Visibility="Collapsed"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Gemini" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                   
                    <CheckBox x:Name="RunAiCheckBox" Margin="14,6,0,0" IsChecked="True" Content="Run AI analysis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Text="Ready" Foreground="DimGray"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                <Button x:Name="OpenOutputButton" Content="Open Output" Padding="18,7" Margin="0,0,8,0" IsEnabled="False" Click="OpenOutput_Click"/>
                <Button x:Name="AnalyzeButton" Content="Analyze Project" Padding="24,7" FontWeight="Bold" Click="Analyze_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="Summary">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,12">
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="Packages" Foreground="DimGray"/><TextBlock x:Name="PackagesCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="C# Files" Foreground="DimGray"/><TextBlock x:Name="FilesCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="Dependency Usages" Foreground="DimGray"/><TextBlock x:Name="UsagesCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="Unique Dependencies" Foreground="DimGray"/><TextBlock x:Name="UniqueCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="Project References" Foreground="DimGray"/><TextBlock x:Name="RefsCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="3"><StackPanel><TextBlock Text="Up/Down Relations" Foreground="DimGray"/><TextBlock x:Name="ProjectDepsCount" FontSize="24" FontWeight="Bold" Text="0"/></StackPanel></Border>
                    </UniformGrid>
                    <DataGrid x:Name="DependenciesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="150"/>
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="110"/>
                            <DataGridTextColumn Header="Dependency" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="170"/>
                            <DataGridTextColumn Header="Occurrences" Binding="{Binding Occurrences}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Project Up/Downstream">
                <DataGrid x:Name="ProjectDependenciesGrid" Margin="10" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="*"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="120"/>
                        <DataGridTextColumn Header="Related Project" Binding="{Binding RelatedProject}" Width="*"/>
                        <DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="190"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Dependency Report (JSON)"><TextBox x:Name="ReportTextBox" Margin="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
            <TabItem Header="AI Impact Report">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F8FC" BorderBrush="#D9E2F3" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="Structured AI report: confirmed project relationships come from static analysis; AI consolidates and explains the evidence." TextWrapping="Wrap" Foreground="#44546A"/>
                    </Border>
                    <RichTextBox x:Name="AiReportBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="#D7DCE5" BorderThickness="1" Background="White"/>
                </Grid>
            </TabItem>
            <TabItem Header="Call Graph"><TextBox x:Name="CallGraphTextBox" Margin="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
            <TabItem Header="Activity Log"><TextBox x:Name="LogTextBox" Margin="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="Gray" Text="Tip: GitHub mode requires Git for Windows. Local mode runs fully on the selected project files."/>
    </Grid>
</Window>
